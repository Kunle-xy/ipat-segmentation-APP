# ====================================
# IPAT Application - Environment Variables
# ====================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ====================================
# Google Cloud Platform Configuration
# ====================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET_ID=ipat_dataset
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-service-account.json

# ====================================
# Backend Configuration
# ====================================
BACKEND_PORT=8010
BACKEND_HOST=0.0.0.0
BACKEND_RELOAD=true
LOG_LEVEL=INFO

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3010,http://localhost:3000

# ====================================
# Frontend Configuration
# ====================================
FRONTEND_PORT=3010
NEXT_PUBLIC_API_URL=http://localhost:8010
NODE_ENV=development

# ====================================
# Production Settings (Optional)
# ====================================
# Uncomment and set these for production deployment

# BACKEND_RELOAD=false
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ====================================
# Docker Configuration
# ====================================
COMPOSE_PROJECT_NAME=ipat

# ====================================
# Instructions
# ====================================
# 1. Copy this file: cp .env.example .env
# 2. Update GCP_PROJECT_ID with your Google Cloud project ID
# 3. Place your GCP service account JSON file in the backend directory
# 4. Update GOOGLE_APPLICATION_CREDENTIALS path if needed
# 5. Run: docker-compose up --build
